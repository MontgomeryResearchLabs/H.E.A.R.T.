---
/**
 * BaseLayout.astro — Root Layout
 * ================================
 * The outermost wrapper for every page on the site. Responsible for:
 *   1. HTML document boilerplate (<html>, <head>, <body>)
 *   2. SEO meta tags (title, description, Open Graph)
 *   3. Loading Google Fonts (Playfair Display + Lora)
 *   4. Importing the global CSS (Tailwind + custom theme)
 *   5. Injecting a <slot /> for page-specific content
 *
 * Props
 * -----
 * - `title`       — Page <title> (defaults to site name)
 * - `description` — Meta description for SEO
 *
 * Usage
 * -----
 * ```astro
 * ---
 * import BaseLayout from '@layouts/BaseLayout.astro';
 * ---
 * <BaseLayout title="Timeline">
 *   <h1>Hello world</h1>
 * </BaseLayout>
 * ```
 */

interface Props {
  /** Page title shown in browser tab */
  title?: string;
  /** SEO meta description */
  description?: string;
}

const {
  title       = 'testing — Our Love Story',
  description = 'A chronological photo timeline celebrating our journey together since July 4, 2023.',
} = Astro.props;

// Import global styles (Tailwind + custom theme CSS)
import '../styles/global.css';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <!-- Encoding & viewport -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0d0d" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Favicon (can be replaced with a custom one later) -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💕</text></svg>" />

    <!--
      Google Fonts — Playfair Display (display headings) & Lora (body text).
      Using `display=swap` so text renders immediately with a fallback font
      while the web font loads.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-h-screen grid-bg">
    <!-- Page content injected here -->
    <slot />

    <!--
      Intersection Observer script: adds a `.visible` class to elements with
      `.fade-in-up` as they scroll into view. Keeps the JS footprint tiny by
      avoiding a React island for this common pattern.
    -->

    <!-- Realistic layered clouds at the bottom of the page -->
    <div class="fixed bottom-0 left-0 right-0 z-30 pointer-events-none" aria-hidden="true">
      <!-- Cloud layer 1 — large soft background clouds -->
      <div class="absolute bottom-0 left-0 right-0 h-48 md:h-64" style="
        background: 
          radial-gradient(ellipse 180px 80px at 10% 90%, rgba(255,255,255,0.95) 0%, transparent 70%),
          radial-gradient(ellipse 250px 100px at 25% 85%, rgba(255,255,255,0.9) 0%, transparent 65%),
          radial-gradient(ellipse 200px 90px at 40% 92%, rgba(255,255,255,0.85) 0%, transparent 70%),
          radial-gradient(ellipse 300px 110px at 55% 80%, rgba(255,255,255,0.95) 0%, transparent 60%),
          radial-gradient(ellipse 220px 85px at 70% 88%, rgba(255,255,255,0.9) 0%, transparent 65%),
          radial-gradient(ellipse 280px 95px at 85% 82%, rgba(255,255,255,0.92) 0%, transparent 60%),
          radial-gradient(ellipse 190px 75px at 95% 90%, rgba(255,255,255,0.88) 0%, transparent 70%);
      "></div>
      <!-- Cloud layer 2 — mid-level detail puffs -->
      <div class="absolute bottom-0 left-0 right-0 h-36 md:h-48" style="
        background:
          radial-gradient(ellipse 120px 60px at 5% 95%, rgba(255,255,255,0.98) 0%, transparent 70%),
          radial-gradient(ellipse 160px 70px at 18% 88%, rgba(255,255,255,0.95) 0%, transparent 65%),
          radial-gradient(ellipse 140px 65px at 32% 92%, rgba(255,255,255,0.9) 0%, transparent 70%),
          radial-gradient(ellipse 180px 75px at 48% 85%, rgba(255,255,255,0.97) 0%, transparent 60%),
          radial-gradient(ellipse 130px 55px at 60% 90%, rgba(255,255,255,0.93) 0%, transparent 65%),
          radial-gradient(ellipse 170px 68px at 75% 87%, rgba(255,255,255,0.96) 0%, transparent 60%),
          radial-gradient(ellipse 150px 62px at 88% 93%, rgba(255,255,255,0.94) 0%, transparent 65%),
          radial-gradient(ellipse 110px 50px at 98% 88%, rgba(255,255,255,0.9) 0%, transparent 70%);
      "></div>
      <!-- Cloud layer 3 — foreground bright solid base -->
      <div class="absolute bottom-0 left-0 right-0 h-20 md:h-28" style="
        background: linear-gradient(to top, rgba(255,255,255,1) 0%, rgba(255,255,255,0.95) 40%, rgba(255,255,255,0) 100%);
      "></div>
    </div>
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                // Once visible, stop observing (animation is one-shot)
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15 },
        );

        document.querySelectorAll('.fade-in-up').forEach((el) => {
          observer.observe(el);
        });
      });
      

    </script>
    
  </body>
</html>
